# Local dev only. On the GRN Commerce platform, PAYLOAD_SECRET is generated
# (or supplied) by the provisioning wizard and written to `site_env_vars`
# before the first deploy is enqueued — you do not create it by hand there.
PAYLOAD_SECRET=replace-with-a-long-random-string-for-local-dev-only

# Not required. Leave unset so the app resolves the SQLite file under
# $GRN_DATA_DIR/db/payload.db (see src/lib/platform-data-dir.ts) — the same
# path convention the platform symlinks into place at deploy time. Only
# set this if you want to point at a specific file locally.
# DATABASE_URL=file:./data/db/payload.db

# Local dev only. On the platform this is set automatically to the site's
# persistent storage directory. Leave unset locally to fall back to
# ./data (gitignored).
# GRN_DATA_DIR=./data
